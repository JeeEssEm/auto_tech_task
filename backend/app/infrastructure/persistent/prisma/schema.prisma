generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "3"
  interface            = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt            @id @default(autoincrement())
  email         String            @unique @db.VarChar(254)
  login         String            @unique @db.VarChar(64)
  first_name    String            @db.VarChar(64)
  middle_name   String?           @db.VarChar(64)
  last_name     String            @db.VarChar(64)
  role          Int               @db.SmallInt
  is_active     Boolean           @default(false)
  password_hash String            @db.VarChar(256)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  chats         Chat[]
  subscriptions SubscriptionLog[]
  sessions      Session[]
  attachments   Attachment[]
  usage_records UsageRecord[]
  generation_runs GenerationRun[]
}

model Session {
  id         String   @id @db.Uuid
  user_id    BigInt
  user_agent String   @db.VarChar(128)
  expires_at DateTime

  user User @relation(fields: [user_id], references: [id])
}

model Chat {
  id       BigInt @id @default(autoincrement())
  name     String @db.VarChar(128)
  template String @db.VarChar(32)
  owner_id BigInt

  owner           User             @relation(fields: [owner_id], references: [id])
  messages        Message[]
  generation_runs GenerationRun[]
}

model Message {
  id      BigInt  @id @default(autoincrement())
  chat_id BigInt

  sender String  @db.VarChar(8)
  body   String? @db.Text

  chat        Chat         @relation(fields: [chat_id], references: [id])
  created_at  DateTime     @default(now())
  attachments Attachment[]
}

model Attachment {
  id       String @id @db.VarChar(128)
  message_id BigInt?
  owner_id   BigInt

  file_name      String @db.VarChar(260)
  file_type      String @db.VarChar(256)
  file_size      Float

  parsing_status String @db.VarChar(16)

  created_at DateTime @default(now())

  owner             User              @relation(fields: [owner_id], references: [id])
  message           Message?          @relation(fields: [message_id], references: [id])
  parsed_attachment ParsedAttachment?
}

model ParsedAttachment {
  id String @id @db.VarChar(128)

  raw_attachment_id String @db.VarChar(128) @unique

  raw_attachment Attachment @relation(fields: [raw_attachment_id], references: [id])
}

model SubscriptionLog {
  id       BigInt   @id @default(autoincrement())
  user_id  BigInt
  tier     String   @db.VarChar(16)
  price    Float    @db.DoublePrecision
  start_dt DateTime
  till_dt  DateTime

  user User @relation(fields: [user_id], references: [id])
}

model UsageRecord {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  action     String   @db.VarChar(32)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, action, created_at])
}

model GenerationRun {
  id         BigInt   @id @default(autoincrement())
  chat_id    BigInt
  user_id    BigInt
  status     String   @db.VarChar(32)
  step       String?  @db.VarChar(128)
  progress   Int      @default(0)
  state_json String?  @db.Text
  result_key String?  @db.VarChar(128)
  error      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  chat Chat @relation(fields: [chat_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@index([chat_id, created_at])
}
