generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = "3"
  interface            = "asyncio"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            BigInt            @id @default(autoincrement())
  email         String            @unique @db.VarChar(254)
  login         String            @unique @db.VarChar(64)
  first_name    String            @db.VarChar(64)
  middle_name   String?           @db.VarChar(64)
  last_name     String            @db.VarChar(64)
  role          Int               @db.SmallInt
  is_active     Boolean           @default(false)
  password_hash String            @db.VarChar(256)
  created_at    DateTime          @default(now())
  updated_at    DateTime          @updatedAt

  chats         Chat[]
  subscriptions SubscriptionLog[]
  sessions      Session[]
  attachments   Attachment[]
  usage_records UsageRecord[]
  generation_runs GenerationRun[]
}

model Session {
  id         String   @id @db.Uuid
  user_id    BigInt
  user_agent String   @db.VarChar(128)
  expires_at DateTime

  user User @relation(fields: [user_id], references: [id])
}

model Chat {
  id       BigInt @id @default(autoincrement())
  name     String @db.VarChar(128)
  template String @db.VarChar(32)
  owner_id BigInt

  owner           User             @relation(fields: [owner_id], references: [id])
  messages        Message[]
  generation_runs GenerationRun[]
}

model Message {
  id      BigInt  @id @default(autoincrement())
  chat_id BigInt

  sender String  @db.VarChar(8)
  body   String? @db.Text

  chat        Chat         @relation(fields: [chat_id], references: [id])
  created_at  DateTime     @default(now())
  attachments Attachment[]
}

model Attachment {
  id       String @id @db.VarChar(128)
  message_id BigInt?
  owner_id   BigInt

  file_name      String @db.VarChar(260)
  file_type      String @db.VarChar(256)
  file_size      Float

  parsing_status String @db.VarChar(16)

  created_at DateTime @default(now())

  owner             User              @relation(fields: [owner_id], references: [id])
  message           Message?          @relation(fields: [message_id], references: [id])
  parsed_attachment ParsedAttachment?
}

model ParsedAttachment {
  id String @id @db.VarChar(128)

  raw_attachment_id String @db.VarChar(128) @unique

  raw_attachment Attachment @relation(fields: [raw_attachment_id], references: [id])
}

model SubscriptionLog {
  id       BigInt   @id @default(autoincrement())
  user_id  BigInt
  tier     String   @db.VarChar(16)
  price    Float    @db.DoublePrecision
  start_dt DateTime
  till_dt  DateTime

  user User @relation(fields: [user_id], references: [id])
}

model UsageRecord {
  id         BigInt   @id @default(autoincrement())
  user_id    BigInt
  action     String   @db.VarChar(32)
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, action, created_at])
}

model GenerationRun {
  id         BigInt   @id @default(autoincrement())
  chat_id    BigInt
  user_id    BigInt
  status     String   @db.VarChar(32)
  step       String?  @db.VarChar(128)
  progress   Int      @default(0)
  state_json String?  @db.Text
  result_key String?  @db.VarChar(128)
  error      String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  chat Chat @relation(fields: [chat_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@index([chat_id, created_at])
}

model LlmGkgFact {
  id               String    @id @default(uuid()) @db.Uuid
  project_id       BigInt
  scope            String    @db.VarChar(128)
  property         String    @db.VarChar(128)
  value            String    @db.Text
  content_raw      String    @db.Text
  status           String    @db.VarChar(16)
  rationale        String    @db.Text
  source_ids       Json
  embedding_vector Unsupported("vector(1024)")?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([project_id])
  @@index([project_id, scope, property])
  @@index([project_id, status])
}

model LlmPendingConflict {
  id           String   @id @default(uuid()) @db.Uuid
  project_id   BigInt
  scope        String   @db.VarChar(128)
  property     String   @db.VarChar(128)
  rationale    String   @db.Text
  options_json Json
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([project_id])
}

model LlmPendingAction {
  id           String    @id @default(uuid()) @db.Uuid
  project_id   BigInt
  question     String    @db.Text
  options_json Json?
  status       String    @db.VarChar(16)
  resolution   String?   @db.Text
  created_at   DateTime  @default(now())
  resolved_at  DateTime?
  updated_at   DateTime  @updatedAt

  @@index([project_id])
  @@index([project_id, status])
}

model LlmRawSourceChunk {
  id          BigInt   @id @default(autoincrement())
  project_id  BigInt
  source_id   String   @db.VarChar(128)
  source_name String   @db.VarChar(260)
  chunk_index Int
  text        String   @db.Text
  created_at  DateTime @default(now())

  @@index([project_id])
  @@index([project_id, source_id])
}

model LlmDocumentSection {
  id           BigInt   @id @default(autoincrement())
  project_id   BigInt
  section_id   String   @db.VarChar(128)
  title        String   @db.VarChar(256)
  level        Int      @default(1)
  required     Boolean  @default(true)
  context_hint String   @db.Text
  content_md   String   @db.Text
  is_manual    Boolean  @default(false)
  updated_at   DateTime @updatedAt
  created_at   DateTime @default(now())

  @@unique([project_id, section_id])
  @@index([project_id])
}
