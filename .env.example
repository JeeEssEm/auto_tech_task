# ---------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------
POSTGRES_DB=autotech_task
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5435/${POSTGRES_DB}"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_USE_ACL=false
REDIS_USER=default
REDIS_USER_PASSWORD=

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=app_user
RABBITMQ_DEFAULT_PASS=change_me

STORAGE_HOST=localhost
STORAGE_PORT=8333
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me
STORAGE_REGION=
STORAGE_BUCKET_NAME=user-files

TASK_QUEUE_QUEUE_NAME=tasks

# ---------------------------------------------------------
# Backend
# ---------------------------------------------------------
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_WORKERS=4

AUTH_SESSION_EXPIRE_SECONDS=2592000
AUTH_USER_ACTIVE=false

QUOTA_FREE_DAILY_MESSAGES=10
QUOTA_FREE_DAILY_UPLOADS=5
QUOTA_FREE_MAX_CHATS=3
QUOTA_PRO_DAILY_MESSAGES=100
QUOTA_PRO_DAILY_UPLOADS=50
QUOTA_PRO_MAX_CHATS=-1

APP_LOG_DIR=logs
APP_LOG_FILE=logs/backend.log
LANGGRAPH_LOG_FILE=logs/langgraph-full.log

# ---------------------------------------------------------
# Frontend
# ---------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_BACKEND_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------
# LLM Pipeline v3 runtime mode
# ---------------------------------------------------------
LLM_PIPELINE_V3_DEPS_MODE=postgres
LLM_PIPELINE_V3_STATE_PATH=artifacts/orchestrator_worker_state.json

# ---------------------------------------------------------
# LLM Pipeline v3: Intent Router
# ---------------------------------------------------------
LLM_PIPELINE_V3_INTENT_ROUTER_PROVIDER=cloud
LLM_PIPELINE_V3_INTENT_ROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PIPELINE_V3_INTENT_ROUTER_MODEL=openai/gpt-oss-120b
LLM_PIPELINE_V3_INTENT_ROUTER_API_KEY=
LLM_PIPELINE_V3_INTENT_ROUTER_TEMPERATURE=0.3
LLM_PIPELINE_V3_INTENT_ROUTER_MAX_TOKENS=32000
LLM_PIPELINE_V3_INTENT_ROUTER_TIMEOUT_SECONDS=20
LLM_PIPELINE_V3_INTENT_ROUTER_RETRIES=3

# ---------------------------------------------------------
# LLM Pipeline v3: Harvester
# ---------------------------------------------------------
LLM_PIPELINE_V3_HARVESTER_PROVIDER=cloud
LLM_PIPELINE_V3_HARVESTER_BASE_URL=https://openrouter.ai/api/v1
LLM_PIPELINE_V3_HARVESTER_MODEL=deepseek/deepseek-chat
LLM_PIPELINE_V3_HARVESTER_API_KEY=
LLM_PIPELINE_V3_HARVESTER_MAX_TOKENS=32000
LLM_PIPELINE_V3_HARVESTER_TIMEOUT_SECONDS=20
LLM_PIPELINE_V3_HARVESTER_MAX_SELF_CORRECTION_RETRIES=3
LLM_PIPELINE_V3_HARVESTER_EVICTION_MAX_OPEN_TOPICS=10

# ---------------------------------------------------------
# LLM Pipeline v3: Grouping Judge
# ---------------------------------------------------------
LLM_PIPELINE_V3_GROUPING_JUDGE_PROVIDER=cloud
LLM_PIPELINE_V3_GROUPING_JUDGE_BASE_URL=https://openrouter.ai/api/v1
LLM_PIPELINE_V3_GROUPING_JUDGE_MODEL=anthropic/claude-3.5-haiku
LLM_PIPELINE_V3_GROUPING_JUDGE_API_KEY=
LLM_PIPELINE_V3_GROUPING_JUDGE_MAX_TOKENS=16348
LLM_PIPELINE_V3_GROUPING_JUDGE_TIMEOUT_SECONDS=20
LLM_PIPELINE_V3_GROUPING_JUDGE_TEMPERATURE=0.1
LLM_PIPELINE_V3_GROUPING_JUDGE_JUDGE_CONCURRENCY=5
LLM_PIPELINE_V3_GROUPING_JUDGE_SEMANTIC_THRESHOLD=0.05

# ---------------------------------------------------------
# LLM Pipeline v3: Consultant
# ---------------------------------------------------------
LLM_PIPELINE_V3_CONSULTANT_PROVIDER=cloud
LLM_PIPELINE_V3_CONSULTANT_BASE_URL=https://openrouter.ai/api/v1
LLM_PIPELINE_V3_CONSULTANT_MODEL=qwen/qwen3-235b-a22b-2507
LLM_PIPELINE_V3_CONSULTANT_API_KEY=
LLM_PIPELINE_V3_CONSULTANT_MAX_TOKENS=16348
LLM_PIPELINE_V3_CONSULTANT_TIMEOUT_SECONDS=20
LLM_PIPELINE_V3_CONSULTANT_TEMPERATURE=0.2
LLM_PIPELINE_V3_CONSULTANT_MAX_TOOL_CALLS=6

# ---------------------------------------------------------
# LLM Pipeline v3: Architect
# ---------------------------------------------------------
LLM_PIPELINE_V3_ARCHITECT_PROVIDER=cloud
LLM_PIPELINE_V3_ARCHITECT_BASE_URL=https://openrouter.ai/api/v1
LLM_PIPELINE_V3_ARCHITECT_MODEL=qwen/qwen3.5-plus-02-15
LLM_PIPELINE_V3_ARCHITECT_API_KEY=
LLM_PIPELINE_V3_ARCHITECT_MAX_TOKENS=16348
LLM_PIPELINE_V3_ARCHITECT_TIMEOUT_SECONDS=20
LLM_PIPELINE_V3_ARCHITECT_TEMPERATURE=0.3
LLM_PIPELINE_V3_ARCHITECT_MAX_TOOL_CALLS=12
LLM_PIPELINE_V3_ARCHITECT_MAX_CONSISTENCY_RETRIES=2

# ---------------------------------------------------------
# LLM Pipeline v3: Embedder
# ---------------------------------------------------------
LLM_PIPELINE_V3_EMBEDDER_MODEL=intfloat/multilingual-e5-large
LLM_PIPELINE_V3_EMBEDDER_BATCH_SIZE=32
LLM_PIPELINE_V3_EMBEDDER_CONCURRENCY=4
